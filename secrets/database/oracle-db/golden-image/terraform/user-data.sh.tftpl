#!/bin/bash
set -euo pipefail
umask 077
install -d -m 0700 /root/oracle-baseline
printf '%s' '${config_b64}' | base64 -d > /root/oracle-baseline/config.json
printf '%s' '${license_b64}' | base64 -d > /root/oracle-baseline/vault.hclic
printf '%s' '${bootstrap_b64}' | base64 -d > /usr/local/sbin/oracle-baseline-bootstrap
printf '%s' '${configure_b64}' | base64 -d > /usr/local/sbin/oracle-baseline-configure
printf '%s' '${verify_b64}' | base64 -d > /usr/local/sbin/oracle-baseline-verify
chmod 0700 /usr/local/sbin/oracle-baseline-*
exec /usr/local/sbin/oracle-baseline-bootstrap
