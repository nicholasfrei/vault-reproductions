aws_region = "us-east-1"
# aws_profile  = "<aws-profile>"
name_prefix    = "oracle-baseline"
key_name       = "<existing-ec2-key-pair>"
admin_ssh_cidr = "<trusted-ipv4-address>/32"

instance_type    = "t3.large"
root_volume_size = 80
# ami_id        = "<amazon-linux-2023-x86-64-ami>"

# Omit for the default single-node lab. Set before provisioning for three Raft voters.
# vault_node_count = 3

vault_version                  = "2.1.1+ent"
oracle_plugin_version          = "0.14.1+ent"
static_role_count              = 100
dynamic_role_count             = 100
static_rotation_period_seconds = 86400

# Supply the license only through TF_VAR_vault_license, not this file.
# Changing bootstrap inputs replaces the VM. Export evidence before applying.
