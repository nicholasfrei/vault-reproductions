#!/usr/bin/env bash

set -euo pipefail
umask 077

install -d -m 0700 /root/oracle-lab
install -d -m 0755 /opt/oracle-lab
printf '%s' '${region_b64}' | base64 -d > /root/oracle-lab/region
printf '%s' '${kms_b64}' | base64 -d > /root/oracle-lab/kms-key
printf '%s' '${license_b64}' | base64 -d > /root/oracle-lab/license
printf '%s' '${password_b64}' | base64 -d > /root/oracle-lab/ssh-password
%{ for name, content in scripts ~}
printf '%s' '${content}' | base64 -d > /opt/oracle-lab/${name}
chmod 0755 /opt/oracle-lab/${name}
%{ endfor ~}
/opt/oracle-lab/bootstrap.sh
