

aws_region       = "us-east-1"
name_prefix      = "oracle-rotation-lab"
instance_type    = "t3.large"
root_volume_size = 80
key_name         = "<ec2_key_pair_name>"
admin_ssh_cidr   = "<your_admin_ip_cidr>"
# aws_profile = "<aws_profile>"
# Without access to hc-base images, use public Amazon Linux 2023:
# ami_owner        = "amazon"
# ami_name_pattern = "al2023-ami-2023.*-kernel-6.1-x86_64"
# vault_version  = "1.21.9+ent"
# plugin_version = "0.11.0+ent"
# Supply the license using TF_VAR_vault_license, not this file.
