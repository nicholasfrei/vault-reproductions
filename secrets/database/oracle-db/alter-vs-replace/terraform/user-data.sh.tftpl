#!/usr/bin/env bash
set -euo pipefail
umask 077

mkdir -p /etc/oracle-lab /etc/vault.d /usr/local/sbin
cat > /etc/oracle-lab/lab.env <<'LAB_CONFIG'
export VAULT_VERSION='${vault_version}'
export ORACLE_PLUGIN_VERSION='${oracle_plugin_version}'
LAB_CONFIG
chmod 0600 /etc/oracle-lab/lab.env
printf '%s' '${vault_license_b64}' | base64 -d > /etc/vault.d/vault.hclic
chmod 0600 /etc/vault.d/vault.hclic

base64 -d > /usr/local/sbin/oracle-lab-bootstrap.sh <<'LAB_BOOTSTRAP'
${bootstrap_b64}
LAB_BOOTSTRAP
base64 -d > /usr/local/sbin/oracle-lab-setup.sh <<'LAB_SETUP'
${setup_b64}
LAB_SETUP
base64 -d > /usr/local/sbin/register-candidate.sh <<'LAB_CANDIDATE'
${candidate_register_b64}
LAB_CANDIDATE
chmod 0700 /usr/local/sbin/oracle-lab-bootstrap.sh /usr/local/sbin/oracle-lab-setup.sh /usr/local/sbin/register-candidate.sh

/usr/local/sbin/oracle-lab-bootstrap.sh
