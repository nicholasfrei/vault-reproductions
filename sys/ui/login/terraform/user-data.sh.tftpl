#!/bin/bash
set -euo pipefail

exec > >(tee /var/log/vault-user-data.log | logger -t vault-user-data -s 2>/dev/console) 2>&1

VAULT_VERSION="${vault_version}"
VAULT_LICENSE_B64="${vault_license_b64}"

printf '%s' "$VAULT_LICENSE_B64" | base64 -d > /tmp/vault.hclic
chmod 600 /tmp/vault.hclic

dnf install -y wget unzip jq

cd /tmp
wget -q "https://releases.hashicorp.com/vault/$${VAULT_VERSION}/vault_$${VAULT_VERSION}_linux_amd64.zip"
unzip -o "vault_$${VAULT_VERSION}_linux_amd64.zip" vault
mv vault /usr/local/bin/vault
chmod 0755 /usr/local/bin/vault
vault version

useradd --system --home /etc/vault.d --shell /bin/false vault || true

mkdir -p /etc/vault.d
mkdir -p /opt/vault/data
mkdir -p /var/log/vault

mv /tmp/vault.hclic /etc/vault.d/vault.hclic
chown root:vault /etc/vault.d/vault.hclic
chmod 0640 /etc/vault.d/vault.hclic

# Fetch private IP via IMDSv2
IMDS_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
LOCAL_IP=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  "http://169.254.169.254/latest/meta-data/local-ipv4")

# Vault config — static values from Terraform are written directly; only
# LOCAL_IP is fetched at runtime since it is not known until the instance starts.
tee /etc/vault.d/vault.hcl > /dev/null <<EOF
ui            = true
disable_mlock = true

api_addr     = "http://$${LOCAL_IP}:8200"
cluster_addr = "http://$${LOCAL_IP}:8201"

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = 1
}

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "${node_id}"

  retry_join {
    auto_join             = "provider=aws region=${aws_region} tag_key=vault-repro tag_value=true"
    auto_join_scheme      = "http"
    auto_join_port        = 8200
  }
}

seal "awskms" {
  region     = "${aws_region}"
  kms_key_id = "${kms_key_id}"
}
EOF

chown -R vault:vault /etc/vault.d /opt/vault /var/log/vault
chmod 0750 /etc/vault.d
chmod 0750 /opt/vault/data
chown root:vault /etc/vault.d/vault.hcl
chmod 0640 /etc/vault.d/vault.hcl

tee /etc/vault.d/vault.env > /dev/null <<'EOF'
VAULT_LICENSE_PATH=/etc/vault.d/vault.hclic
AWS_REGION=${aws_region}
EOF

chown root:vault /etc/vault.d/vault.env
chmod 0640 /etc/vault.d/vault.env

tee /etc/systemd/system/vault.service > /dev/null <<'UNIT'
[Unit]
Description=HashiCorp Vault
Documentation=https://developer.hashicorp.com/vault/docs
After=network-online.target
Wants=network-online.target

[Service]
User=vault
Group=vault
ExecStart=/usr/local/bin/vault server -config=/etc/vault.d/vault.hcl
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
EnvironmentFile=/etc/vault.d/vault.env

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable vault
systemctl start vault

touch /var/log/vault-user-data-complete
