aws_region     = "us-east-1"
aws_profile    = null
name_prefix    = "vault-migrate-lab"
key_name       = "<ec2_key_pair_name>"
admin_ssh_cidr = "<your_admin_ip>/32"

# Leave null to use the latest Amazon Linux 2023 x86_64 AMI.
ami_id = null

vault_instance_type    = "m6i.large"
postgres_instance_type = "t3.medium"
root_volume_size       = 40

vault_version   = "1.19.6"
vault_log_level = "info"

postgres_db_name = "vault"
postgres_db_user = "vault"

# Set sensitive values via environment variables instead of committing them here:
#   export TF_VAR_vault_license="$VAULT_LICENSE"
#   export TF_VAR_postgres_db_password="<password>"
vault_license        = "<vault_license_text>"
postgres_db_password = "<postgres_password>"

extra_tags = {
  Owner = "<email>"
}
